{
  "name": "@roleflock/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node scripts/bundle-workflows.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "@roleflock/agent-events": "workspace:*",
    "@roleflock/approval-engine": "workspace:*",
    "@roleflock/change-contracts": "workspace:*",
    "@roleflock/change-passport": "workspace:*",
    "@roleflock/command-runner": "workspace:*",
    "@roleflock/context-compiler": "workspace:*",
    "@roleflock/contracts": "workspace:*",
    "@roleflock/database": "workspace:*",
    "@roleflock/evidence": "workspace:*",
    "@roleflock/graph-core": "workspace:*",
    "@roleflock/graph-ir": "workspace:*",
    "@roleflock/graph-runtime": "workspace:*",
    "@roleflock/graph-ui": "workspace:*",
    "@roleflock/language": "workspace:*",
    "@roleflock/observability": "workspace:*",
    "@roleflock/provider-claude": "workspace:*",
    "@roleflock/provider-codex": "workspace:*",
    "@roleflock/provider-core": "workspace:*",
    "@roleflock/provider-cursor": "workspace:*",
    "@roleflock/provider-custom": "workspace:*",
    "@roleflock/provider-opencode": "workspace:*",
    "@roleflock/repository-runtime": "workspace:*",
    "@roleflock/role-protocol": "workspace:*",
    "@roleflock/role-recommender": "workspace:*",
    "@roleflock/run-control": "workspace:*",
    "@roleflock/secret-store": "workspace:*",
    "@roleflock/usage-ledger": "workspace:*",
    "@roleflock/verification-runner": "workspace:*",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist"
