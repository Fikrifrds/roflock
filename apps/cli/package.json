{
  "name": "roflock",
  "version": "0.1.0",
  "description": "Roflock — AI coding teams as code.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fikrifrds/roflock.git"
  },
  "homepage": "https://github.com/Fikrifrds/roflock#readme",
  "bugs": "https://github.com/Fikrifrds/roflock/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "roflock": "./dist/bin/roflock.js",
    "roflock-lsp": "./dist/bin/roflock-lsp.js",
    "roflock-mcp": "./dist/bin/roflock-mcp.js",
    "roleflock": "./dist/bin/roleflock.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "prepack": "node scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/package-smoke.mjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "passport": "node apps/cli/dist/bin/roflock.js passport"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@roleflock/language-server": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
