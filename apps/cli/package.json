{
  "name": "@roleflock/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "roflock": "./apps/cli/dist/bin/roflock.js",
    "roleflock": "./apps/cli/dist/bin/roleflock.js"
  },
  "scripts": {
