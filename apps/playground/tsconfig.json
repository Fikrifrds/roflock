{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals"]
  },
  // vitest.config.ts is excluded for the same reason as apps/web: `vitest/config`
  // resolves Vite 7 types while the app builds on Vite 6, and the two Plugin
  // types disagree.
  "include": ["src", "test", "vite.config.ts"]
}
