{
  "name": "@roleflock/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@roleflock/agent-events": "workspace:*",
    "@roleflock/change-passport": "workspace:*",
    "@roleflock/change-contracts": "workspace:*",
    "@roleflock/contracts": "workspace:*",
    "@roleflock/role-recommender": "workspace:*",
    "@roleflock/role-protocol": "workspace:*",
    "@roleflock/verification-runner": "workspace:*",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
