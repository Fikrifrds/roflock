{
  "name": "@roleflock/graph-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@roleflock/contracts": "workspace:*",
    "@roleflock/graph-core": "workspace:*",
    "@roleflock/database": "workspace:*",
    "@roleflock/role-protocol": "workspace:*"
  },
  "devDependencies": {
    "@roleflock/graph-ir": "workspace:*",
    "@roleflock/language": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
