{
  "name": "roleflock",
  "version": "0.1.0",
  "private": true,
  "description": "Roflock \u2014 AI coding teams as code. Compiler-driven runtime for defining, running, and verifying AI coding teams.",
  "bin": {
    "roleflock": "./apps/cli/dist/cli.js"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @roleflock/playground build && pnpm --filter @roleflock/daemon build && pnpm --dir apps/cli build",
    "dev": "pnpm --filter @roleflock/daemon dev",
    "dev:web": "pnpm --filter @roleflock/web dev",
    "dev:playground": "pnpm --filter @roleflock/playground dev",
    "build:playground:public": "pnpm --filter @roleflock/playground build:public",
    "start": "pnpm build && pnpm --filter @roleflock/daemon start",
    "url": "node scripts/print-url.mjs",
    "diagnostics": "node scripts/diagnostics.mjs",
    "passport": "node apps/cli/dist/cli.js passport",
    "benchmark": "node scripts/benchmark-verified-fix.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter=./packages/* test && pnpm -r --filter=./apps/* test",
    "test:unit": "pnpm -r --filter=./packages/* test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  },
  "license": "Apache-2.0"
}
