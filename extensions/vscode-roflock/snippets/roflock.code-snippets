{
  "Workflow": {
    "prefix": "workflow",
    "body": [
      "workflow ${1:Name} {",
      "  version \"1.0.0\"",
      "  description \"${2:What this workflow achieves}\"",
      "}",
      "",
      "role ${3:implementer} {",
      "  write",
      "}",
      "",
      "agent ${4:Builder} {",
      "  role ${3:implementer}",
      "  objective \"${5:Make the requested change}\"",
      "  retry 2",
      "}",
      "",
      "human ${6:Accept} {",
      "  title \"${7:Accept the result}\"",
      "  decisions approve, reject",
      "}",
      "",
      "flow {",
      "  ${4:Builder} -> ${6:Accept}",
      "}",
    ],
    "description": "A minimal Roflock workflow with an explicit human outcome.",
  },
  "Deterministic check": {
    "prefix": "check",
    "body": ["check ${1:Tests} {", "  run \"${2:pnpm test}\"", "  required", "}"],
    "description": "A required deterministic check.",
  },
}
